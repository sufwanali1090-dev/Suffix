# =============================================================================
# SUFFIX TRADING DESK — environment template
# Copy to `.env` (never commit). Every value is optional except the ones marked
# REQUIRED-FOR-LIVE-DATA; SUFFIX runs fully in simulated mode without any keys.
# =============================================================================

# --- Account / Do-or-Die directive -------------------------------------------
SUFFIX_STARTING_CAPITAL=100.00
SUFFIX_DEATH_LINE=80.00
SUFFIX_RISK_MIN_PCT=1.0
SUFFIX_RISK_MAX_PCT=2.0
SUFFIX_ALLOWED_LEVERAGE=3,5,10
SUFFIX_MAX_CONCURRENT_POSITIONS=2
SUFFIX_DAILY_LOSS_LIMIT_PCT=5.0
SUFFIX_CONSECUTIVE_LOSS_COOLDOWN=3
SUFFIX_MIN_SHARPE=1.8
SUFFIX_MIN_PROFIT_FACTOR=1.5
SUFFIX_MUTATION_GENERATIONS=50

# --- Execution mode: paper | testnet | live(disabled by policy) ---------------
SUFFIX_EXECUTION_MODE=paper
SUFFIX_ALLOW_TESTNET=0

# --- Market data --------------------------------------------------------------
# https://finnhub.io/register  (free tier: 60 req/min)
FINNHUB_API_KEY=
FINNHUB_BASE=https://finnhub.io/api/v1

# --- Local AI sidecars --------------------------------------------------------
# whisper.cpp STT (build in modules/whisper.cpp, run with --server)
SUFFIX_STT_BACKEND=whisper_cpp
WHISPER_CPP_URL=http://127.0.0.1:8082/inference
WHISPER_CPP_BIN=modules/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=modules/whisper.cpp/models/ggml-base.en.bin

# Kokoro-82M TTS (https://huggingface.co/hexgrad/Kokoro-82M) via kokoro-fastapi
SUFFIX_TTS_BACKEND=kokoro
KOKORO_URL=http://127.0.0.1:8880/v1/audio/speech
KOKORO_VOICE=am_michael
KOKORO_SPEED=1.0

# ElevenLabs TTS (fallback / premium voice) — https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- Binance Testnet (PILOT, only when SUFFIX_ALLOW_TESTNET=1) ---------------
BINANCE_TESTNET_BASE=https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- TradingView Desktop MCP (https://www.cloud9markets.com/claude-tradingview-setup.html)
SUFFIX_MCP_TRADINGVIEW=1
TRADINGVIEW_MCP_COMMAND=npx
TRADINGVIEW_MCP_ARGS=-y,@modelcontextprotocol/server-tradingview
TRADINGVIEW_DESKTOP_CDP=http://127.0.0.1:9222

# --- Agent 11 (QUANTUM) -------------------------------------------------------
SUFFIX_QUANTUM_ENABLED=1
SUFFIX_QUANTUM_SYMBOLS=BTC-USD,ETH-USD,SOL-USD,SPY,QQQ
SUFFIX_QUANTUM_TIMEFRAME=4h
SUFFIX_QUANTUM_STUDY=quantum_v1
SUFFIX_QUANTUM_TRIALS_PER_GENERATION=40
SUFFIX_QUANTUM_BG_INTERVAL_SEC=900
SUFFIX_QUANTUM_SEED=1337

# --- Networking ---------------------------------------------------------------
SUFFIX_API_HOST=0.0.0.0
SUFFIX_API_PORT=8000
SUFFIX_WS_PATH=/ws
SUFFIX_LOG_LEVEL=INFO

# --- Telemetry ----------------------------------------------------------------
# How often the desk pushes a telemetry frame to connected HUDs (seconds).
# Lower = smoother ring/orb, higher = quieter socket. Frames are ~4 KB.
SUFFIX_TELEMETRY_INTERVAL_SEC=2
