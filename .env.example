# ── F.R.I.D.A.Y. desk · copy to .env ──────────────────────────────────────────
# Everything here is optional. With no keys the desk still runs, it just refuses
# to invent numbers: live panels show "—" and the feed badge reads SIM.

# 1. Market data — free key: https://finnhub.io/dashboard
FINNHUB_KEY=
# Poll cadence for quotes, in ms. Free tier allows ~60 calls/min across all symbols.
QUOTE_POLL_MS=60000

# 2. Reasoning — optional. Without a key the master uses the built-in
#    deterministic router + template synthesis (fully functional, less eloquent).
#    The desk was designed for a long-context reasoning model; Fable 5 recommended.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-fable-5
LLM_BASE_URL=https://api.anthropic.com/v1/messages
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=25000

# 3. The ears — local speech-to-text. The browser uses the Web Speech API when
#    available; otherwise commands are forwarded here.
WHISPER_BIN=
# e.g. WHISPER_BIN=/opt/homebrew/bin/whisper-cli
WHISPER_MODEL=ggml-small.bin
WHISPER_ARGS=--language en --model ./WHISPER_MODEL --no-prints --output-txt

# 4. The voices — local TTS. Each agent gets its own voice (see docs/VOICES.md).
#    Voicebox / Kokoro / any HTTP server that takes {text, voice} -> audio/wav.
TTS_BRIDGE_URL=
TTS_DEFAULT_FORMAT=wav

# 5. Chart takeover — TradingView MCP bridge (see docs/TRADINGVIEW-MCP.md).
#    When set, CHARTIST's "draw this level" calls go to your real charts.
TRADINGVIEW_MCP_URL=
TRADINGVIEW_SYMBOLS=NVDA,AAPL,SPY,QQQ,TSLA

# 6. Execution — PAPER ONLY unless you wire a broker adapter yourself.
EXECUTION_MODE=paper
ACCOUNT_EQUITY=25000
# Risk officer's standing limits (percent of equity)
MAX_RISK_PCT=1.0
MAX_POSITION_PCT=10
MAX_DAILY_LOSS_PCT=3

# 7. Server
PORT=8787
HOST=0.0.0.0
# Leave unset for real data only. Set to 1 to run the desk on labelled
# simulated quotes (badge says SIM everywhere) for demos and screenshots.
DEMO_FEED=0
# ALLOW_SIM=0 forbids the simulated feed entirely: with no key the market
# panels then render "—" instead. Use it for any strictly real-data build.
ALLOW_SIM=1
