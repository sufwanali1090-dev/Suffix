# Line-ending policy.
#
# Windows batch files are parsed by cmd.exe and misbehave with LF-only line
# endings (notably around labels and goto targets). Force CRLF on checkout for
# them regardless of which OS authored the change, and keep shell scripts LF
# so they keep working on Linux/macOS and in containers.

*.bat   text eol=crlf
*.cmd   text eol=crlf

*.sh    text eol=lf
*.bash  text eol=lf

# Dockerfile / shebang-sensitive files must never gain a BOM or CRLF.
Dockerfile  text eol=lf
*.py        text
*.ts        text
*.tsx       text
*.js        text
*.mjs       text
*.json      text
*.md        text
*.css       text
*.html      text

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.bin   binary
*.db    binary
