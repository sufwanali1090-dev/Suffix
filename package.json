{
  "name": "suffix-trading-desk",
  "version": "1.0.0",
  "private": true,
  "description": "SUFFIX TRADING DESK \u2014 cinematic AI desktop trading desk. Nine agents, one voice.",
  "author": "SUFFIX Systems",
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev": "concurrently -k -n api,hud,shell -c magenta,cyan,yellow \"npm:dev:api\" \"npm:dev:hud\" \"npm:dev:shell\"",
    "dev:api": "python3 -m uvicorn server.main:app --host 0.0.0.0 --port 8000 --log-level info",
    "dev:hud": "vite --host 0.0.0.0 --port 5173",
    "dev:shell": "npm run build:electron && wait-on tcp:5173 tcp:8000 && cross-env SUFFIX_DEV=1 electron .",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/postbuild-electron.mjs",
    "build:hud": "vite build",
    "build": "npm run typecheck && npm run build:electron && npm run build:hud",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "modules:clone": "bash scripts/clone_modules.sh",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "test:hud": "vitest run",
    "test:api": "python3 -m pytest -q server/tests"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.suffix.tradingdesk",
    "productName": "SUFFIX TRADING DESK",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "server/**/*.py",
      "requirements.txt",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      },
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Finance"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    }
  }
}
